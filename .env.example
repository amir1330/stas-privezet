# ── Paths ─────────────────────────────────────────────────────────────────────
# Read-only scrape data (do not write here — crawler lives in stas-poison)
DATA_DIR=/home/amir1330/projects/stas-poison/data

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5433/marketplace
DATABASE_URL_SYNC=postgresql+psycopg://marketplace:marketplace@localhost:5433/marketplace

# ── Redis (rate limiting only — caching uses Postgres cache_entries) ─────────
REDIS_URL=redis://localhost:6379/0

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ── Object storage (Cloudflare R2 / S3-compatible) ───────────────────────────
S3_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=marketplace-images
CDN_BASE_URL=https://cdn.example.com

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── App ───────────────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
